# --- Applicazione -----------------------------------------------------------
APP_NAME=Scadenzario

# Database CONDIVISO fra le postazioni: scadenze, categorie, impostazioni.
# In produzione PostgreSQL gestito (Neon/Supabase), con SSL obbligatorio:
#   postgresql+psycopg://utente:password@host.neon.tech/scadenzario?sslmode=require
DATABASE_URL=sqlite:///./scadenzario.db

# Database LOCALE alla postazione: quali avvisi sono già stati mostrati qui.
# Vuoto = %LOCALAPPDATA%\Scadenzario\locale.db (consigliato).
LOCAL_DATABASE_URL=

# Nome della postazione nei log (vuoto = nome del computer)
DEVICE_NAME=
# Mettere a true su UNA SOLA postazione, altrimenti ogni PC acceso invia
# la propria copia delle email.
EMAIL_SENDER_DEVICE=false

TIMEZONE=Europe/Rome
# Origine del dev server Angular (vedi lo script `start` in frontend/package.json)
CORS_ORIGINS=http://localhost:4300

# --- Avvisi -----------------------------------------------------------------
# Giorni di preavviso di default (0 = il giorno stesso della scadenza)
DEFAULT_ALERT_OFFSETS=30,15,7,3,1,0
# Sollecito ogni N giorni dopo la scadenza (0 per disattivare) e numero massimo
OVERDUE_REPEAT_DAYS=3
OVERDUE_MAX_REMINDERS=5
# Orario di invio delle notifiche del giorno
DAILY_SEND_TIME=08:00
# Ogni quanti secondi lo scheduler controlla se ci sono avvisi da spedire
SCHEDULER_INTERVAL_SECONDS=300

# --- Web Push (notifiche desktop) -------------------------------------------
# Generare con: python -m app.tools.vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Email (opzionale) ------------------------------------------------------
# Lasciare SMTP_HOST vuoto per tenere il canale email disattivato
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=scadenzario@example.com
SMTP_USE_TLS=true
